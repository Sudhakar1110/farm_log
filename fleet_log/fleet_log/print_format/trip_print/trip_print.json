 "html": "<div class=\"print-heading\">\n\t<h2>Trip {{ doc.name }}</h2>\n\t{% if doc.status %}<p class=\"text-muted\">Status: <strong>{{ doc.status }}</strong></p>{% endif %}\n</div>\n<hr>\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr><td style=\"width: 30%\"><b>Vehicle</b></td><td>{{ doc.vehicle }}</td></tr>\n\t\t<tr><td><b>Driver</b></td><td>{{ doc.driver }}</td></tr>\n\t\t<tr><td><b>Trip Type</b></td><td>{{ doc.trip_type or '' }}</td></tr>\n\t\t<tr><td><b>Company</b></td><td>{{ doc.company or '' }}</td></tr>\n\t\t<tr><td><b>Purpose</b></td><td>{{ doc.purpose or '' }}</td></tr>\n\t</tbody>\n</table>\n<h4>Route &amp; Odometer</h4>\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 30%\"><b>Start Location</b></td><td>{{ doc.start_location or '' }}</td>\n\t\t\t<td style=\"width: 30%\"><b>End Location</b></td><td>{{ doc.end_location or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>Start Odometer</b></td><td>{{ doc.start_odometer }}</td>\n\t\t\t<td><b>End Odometer</b></td><td>{{ doc.end_odometer or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>Start Time</b></td><td>{{ doc.start_time or '' }}</td>\n\t\t\t<td><b>End Time</b></td><td>{{ doc.end_time or '' }}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n<h4>Performance</h4>\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 30%\"><b>Distance Covered</b></td><td>{{ doc.distance_covered or 0 }} km</td>\n\t\t\t<td style=\"width: 30%\"><b>Total Fuel Used</b></td><td>{{ doc.total_fuel_used or 0 }} litres</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>Trip Yield</b></td><td>{{ doc.trip_yield or 0 }} km/litre</td>\n\t\t\t<td><b>Yield Flag</b></td><td>{{ doc.yield_flag or '' }}</td>\n\t\t</tr>\n\t</tbody>\n</table>",
