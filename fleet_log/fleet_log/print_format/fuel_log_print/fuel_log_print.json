 "html": "<div class=\"print-heading\">\n\t<h2>Fuel Log {{ doc.name }}</h2>\n</div>\n<hr>\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr><td style=\"width: 30%\"><b>Vehicle</b></td><td>{{ doc.vehicle }}</td></tr>\n\t\t<tr><td><b>Linked Trip</b></td><td>{{ doc.trip or 'Standalone' }}</td></tr>\n\t\t<tr><td><b>Filled By</b></td><td>{{ doc.filled_by or '' }}</td></tr>\n\t\t<tr><td><b>Fuel Type</b></td><td>{{ doc.fuel_type or '' }}</td></tr>\n\t\t<tr><td><b>Fuel Vendor / Station</b></td><td>{{ doc.fuel_vendor or '' }}</td></tr>\n\t\t<tr><td><b>Odometer at Fill</b></td><td>{{ doc.odometer_at_fill }}</td></tr>\n\t</tbody>\n</table>\n<h4>Cost</h4>\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 30%\"><b>Fuel Quantity</b></td><td>{{ doc.fuel_quantity }} litres</td>\n\t\t\t<td style=\"width: 30%\"><b>Fuel Cost</b></td><td>{{ doc.fuel_cost }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>Price per Litre</b></td><td>{{ doc.price_per_litre or 0 }}</td>\n\t\t\t<td><b>Sanity Flag</b></td><td>{{ doc.sanity_flag or '' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>Fill-up Yield</b></td><td colspan=\"3\">{{ doc.fill_up_yield or 0 }} km/litre</td>\n\t\t</tr>\n\t</tbody>\n</table>",
